# ============================================================
# LLM（DeepSeek）
# 创建地址：https://platform.deepseek.com/api-keys
# ============================================================
DEEPSEEK_API_KEY=your-deepseek-api-key

# ============================================================
# GitHub OAuth App（用于网页登录）
# 创建地址：https://github.com/settings/developers
# ============================================================
GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret

# ============================================================
# GitHub App（用于 webhook 自动审查 + commit status）
# 创建地址：https://github.com/settings/apps
# ============================================================
# App 设置页顶部的 App ID（纯数字）
GITHUB_APP_ID=

# 私钥（PKCS#8 PEM 格式，含首尾 -----BEGIN/END PRIVATE KEY-----）
# 生成方式：
#   1. 在 App 设置页点 "Generate a private key" 下载 .pem 文件
#   2. 执行转换：
#      openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt \
#        -in downloaded-key.pem -out private-key-pkcs8.pem
#   3. 将 private-key-pkcs8.pem 全部内容粘贴到此处
GITHUB_APP_PRIVATE_KEY=

# App 设置页配置的 Webhook Secret
GITHUB_WEBHOOK_SECRET=

# Personal Access Token（可选，仅在无用户 session 的场景下用）
GITHUB_TOKEN=

# ============================================================
# pullcat 服务自身对外访问地址（用于 commit status Details 链接）
# ============================================================
PULLCAT_BASE_URL=https://your-domain.com
