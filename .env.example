# =============================================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入真实值：
# cp .env.example .env
# =============================================================================

# DeepSeek API Key（必填）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# GitHub Personal Access Token（可选，OAuth 登录后无需配置）
# 未登录用户或 webhook 自动审查时使用。
# 需要 repo 权限（私有仓库）或 public_repo 权限（公开仓库）
# 生成地址：https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_github_token_here

# GitHub OAuth App 凭据（可选，用于用户登录）
# 创建地址：https://github.com/settings/developers → New OAuth App
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:5173/login/oauth2/code/github
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# GitHub App 配置（启用自动 webhook 审查时必填）
# App 设置页可获取 App ID、Client ID / Client Secret、Webhook Secret
GITHUB_APP_ID=1234567
# 私钥需为 PKCS#8 PEM 内容，可将整段多行内容直接写入 .env
# 例如：
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# 前端安装入口（Dashboard 安装横幅使用）
# 示例：https://github.com/apps/your-app-name/installations/new
VITE_GITHUB_APP_INSTALL_URL=

# Redis 连接（可选，默认 localhost:6379）
REDIS_HOST=localhost
REDIS_PORT=6379
